# ScamShield AI - Environment Configuration

# Flask Environment
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=scamshield-super-secret-dev-key-change-in-prod
PORT=5000
DEBUG=True

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///scamshield.sqlite
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/scamshield_db

# Twilio WhatsApp API Credentials (Optional for local testing / simulator)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# Twilio Signature Verification (Set to false during local simulation / ngrok dev testing)
VERIFY_TWILIO_SIGNATURE=False

# Fact-Checking API Configuration (Optional)
# Google Fact Check Tools API / ClaimReview API
GOOGLE_FACT_CHECK_API_KEY=
USE_MOCK_FACT_CHECK_DB=True

# Data Retention Policy (days to retain scan logs, 0 for infinite)
DATA_RETENTION_DAYS=30
HASH_PHONE_NUMBERS=True
MASK_SENSITIVE_TEXT=True
